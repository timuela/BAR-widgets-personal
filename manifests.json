    "id": "gui_zombie_wreck_timers",
    "version": "2.0.0",
    "display_name": "Zombie Wreck Timers",
    "author": "SethDGamre + Egzothicki",
    "discord_link": "https://discord.com/channels/549281623154229250/1113845509891829810/threads/1530224845953175763",
    "github_link": "https://github.com/beyond-all-reason/BAR-Widgets/tree/main/Widgets/community/gui_zombie_wreck_timers",
    "description": "For games with the Zombies modoption. Shows a countdown over every wreck telling you exactly when it reanimates, straight from the timer the game now publishes for this purpose. White with plenty of time, purple as the rise nears, pulsing in the final seconds. The countdown reacts the moment a corpse is reclaimed or resurrected, and a purple '?' marks fogged wrecks whose timer may have changed unseen. Display only.",
    "last_updated": "2026-08-11T18:00:00.000Z"
  },
